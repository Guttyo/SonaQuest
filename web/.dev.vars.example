# 手元で Workers（npm --prefix web run dev:worker）を動かすときの秘密情報の雛形。
#
# 使い方：
#   1. この雛形を、同じ web/ フォルダに .dev.vars という名前で写す
#        cp web/.dev.vars.example web/.dev.vars
#   2. .dev.vars の「=」の後に値を書く（引用符は要らない）
#
# .dev.vars は .gitignore で Git の対象外。本物の値は .dev.vars にだけ書き、この雛形には書かない。
# 公開する Workers では、同じ名前を `wrangler secret put <名前>` で Cloudflare の secrets に入れる
# （デプロイはオーナーの承認の後。ADR-0003）。キーはブラウザに出さない（VITE_ で始まる名前にしない）。

# Claude API のキー（必須。/api/turn で使う。docs/phase2-decisions.md 項目12）
ANTHROPIC_API_KEY=

# ElevenLabs のキーと声の ID（音声合成。ADR-0005、ADR-0033）。読み上げの中継（/api/tts）で使う。
# 無いときは、画面がブラウザの読み上げに切り替える
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 読み上げる Claude の文の署名に使う秘密の値（Issue #284。32 文字以上）。/api/turn が署名し、/api/tts が確かめる。
# 無いときは /api/tts が ElevenLabs を呼ばず、画面はブラウザの読み上げに切り替える（訓練は最後まで進む）。
# 値は自分で作る（例：openssl rand -base64 32 の出力）。公開する Workers では secrets に同じ名前で入れる
TTS_SIGNING_KEY=

# 開発中だけ会話の本文をログに出す切り替え（ADR-0007 の追記）は、秘密情報ではないのでここに書かない。
# 既定でオフにしておき、使うときだけ次のように指定する：
#   npx --prefix web wrangler dev --port 8787 --var DEV_CONTENT_LOG:1
