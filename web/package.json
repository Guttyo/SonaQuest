{
  "name": "sonaquest-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:worker:lab": "wrangler dev --port 8787 --var DEV_EXPERIMENT:1",
    "build": "tsc --noEmit && vite build",
    "bundle:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:board-chat": "node scripts/setup-board-chat.ts",
    "setup:karte-audit": "node scripts/setup-karte-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.156.0"
  }
}
