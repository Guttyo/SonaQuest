// Cloudflare Workers の設定（ADR-0003）。デプロイはオーナーの承認の後（CLAUDE.md 絶対ルール7）。
// API キーは secrets（手元では .dev.vars）にだけ置き、ここには書かない。DEV_CONTENT_LOG もここには書かない（ADR-0007 の追記）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonaquest",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  // 画面のファイル（npm run build の dist/）。/api/ 以外はここから配る
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Workers Logs は使わない（ADR-0007。会話の本文を Cloudflare 側に残さない）
  "observability": {
    "enabled": false
  },
  // 回数制限（ADR-0035、ADR-0065、safety-test-plan P7）。接続元の IP ごとに、60秒で10回まで（Issue #57 のオーナー決定）。
  // もとは Rate Limiting binding（ratelimits）だったが、拠点ごとの近似で、公開環境では別々の接続の要求を止められなかった（Issue #65）。
  // キーごとに Durable Object を1つ持ち、世界全体で1か所で数える（数はメモリだけで、storage は使わない）。
  // 上限と期間は web/worker/strictLimiter.ts。公開の切り替え（PUBLIC_TURN=1）のときだけ使う
  "durable_objects": {
    "bindings": [{ "name": "RATE_COUNTER", "class_name": "RateCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateCounter"] }],
  // ボードの掲示板チャット（B-07、ADR-0047）の Managed Agents の ID。秘密ではない。
  // オーナーが setup スクリプト（npm --prefix web run setup:board-chat）で作り、出た値をここに入れる（手順は docs/board-chat-setup.md）。
  // 空のままなら、チャットはルールで組んだ固定の掲示だけになる。API キーはここに書かない（secrets）。
  // 注意：この ID を入れてデプロイすると、PUBLIC_TURN=1 の公開環境では利用者が Managed Agents を呼べて課金が生じる。
  // 接続元ごとの回数制限（P7）は、ADR-0065 で Durable Objects で数える形にした（公開環境で効くことは、デプロイの後に確かめる）。
  // 回数制限は1つの接続元ごとなので、多くの接続元からの呼び出しの合計を抑えるのは Claude API の月の支出の上限（P9）。
  // デプロイはオーナーの承認の後（docs/board-chat-setup.md）
  "vars": {
    "BOARD_CHAT_ENVIRONMENT_ID": "env_0196dKYCHE3iBj5cc6Yt58M8",
    "BOARD_CHAT_AGENT_HQ": "agent_01YFjq19JrePAN1fmSeQ5ytD",
    "BOARD_CHAT_AGENT_A": "agent_01GCfgzvnPLemZt3dgUD7uPG",
    "BOARD_CHAT_AGENT_B": "agent_01W9z1ZEp3T5oULzQS2xMx1j",
    "BOARD_CHAT_AGENT_C": "agent_01V3XQChcCB4ZUjFB6ve1MNo",
    "BOARD_CHAT_AGENT_D": "agent_01RazAsv5c4YUTDtxuQFWp57",
    // カルテの要約の監査役（B-10、Issue #142）の Agent の ID。オーナーが setup スクリプト（npm --prefix web run setup:karte-audit）で
    // 作って入れる（手順は docs/karte-audit-setup.md）。Environment は上の BOARD_CHAT_ENVIRONMENT_ID を使い回す。
    // 空のままなら、監査は「監査できず（設定なし）」を返し、コードでの確認だけが動く。課金の注意は上の掲示板チャットと同じ
    "KARTE_AUDIT_AGENT_ID": ""
  }
}
